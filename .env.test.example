# Integration-test environment (test-integration/) — local Supabase stack keys.
# Copy to .env.test (gitignored) if you run the stack locally, or let CI
# inject these. The suite REFUSES any non-localhost URL.

# `supabase start` prints these (also: `supabase status -o json`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status
