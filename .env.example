# Supabase — project URL + publishable (anon) key, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — BYPASSES RLS, server-side only (LINE webhook)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — structured parsing of Thai transaction messages (server-side only)
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=
# Used when the primary model is overloaded (429/5xx). Empty string disables.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# LINE Messaging API — webhook signature verification + replies (server-side only)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
