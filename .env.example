# Supabase — project URL + publishable (anon) key, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — BYPASSES RLS, server-side only (LINE webhook)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — structured parsing of Thai transaction messages (server-side only)
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.7-flash
GEMINI_MODEL=
# Tried after the primary; a built-in gemini-3.5-flash-lite rescue remains last.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Daily Gemini request ceiling (free-tier protection); default 100.
GEMINI_DAILY_LIMIT=

# LINE Messaging API — webhook signature verification + replies (server-side only)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
